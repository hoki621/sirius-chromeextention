{
  "manifest_version": 3,
  "name": "Sirius 学習支援",
  "version": "0.2.2",
  "description": "Sirius LMSの課題を読み取り専用で一覧表示する非公式拡張。検証中の試用版です。",
  "permissions": ["storage"],
  "icons": { "32": "icon.png" },
  "action": { "default_title": "Siriusの課題一覧を開く", "default_popup": "popup.html", "default_icon": "icon.png" },
  "content_scripts": [
    {
      "matches": [
        "https://lms.sirius.tuat.ac.jp/portal",
        "https://lms.sirius.tuat.ac.jp/portal?*",
        "https://lms.sirius.tuat.ac.jp/portal/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
